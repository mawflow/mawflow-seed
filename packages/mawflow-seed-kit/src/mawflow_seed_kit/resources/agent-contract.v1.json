{
  "schema": "mawflow.agent_contract.v1",
  "protocol_version": 1,
  "entry_defaults": {
    "schema_version": 3,
    "agent_protocol_version": 1,
    "startup": {
      "recommended_order": [
        "AI_START_HERE.md",
        ".maw/agent-entry.yaml",
        ".maw/agent-context.md",
        ".maw/project.yaml",
        ".maw/components.yaml",
        ".maw/modules.yaml"
      ],
      "read_policy": {
        "docs_are_on_demand": true,
        "prompts_are_manual_only": true,
        "archive_is_not_default_context": true
      }
    },
    "facts": {
      "project": ".maw/project.yaml",
      "subprojects": ".maw/subprojects.yaml",
      "code_sources": ".maw/code-sources.yaml",
      "deployment_targets": ".maw/deployments.yaml",
      "components": ".maw/components.yaml",
      "modules": ".maw/modules.yaml",
      "runtime": ".maw/app-runtime.yaml"
    },
    "protected_paths": {
      "never_commit": [
        ".local/**",
        ".maw/*.local.yaml",
        ".ssh/**",
        "artifacts/**"
      ],
      "manual_only": [
        "prompts/**",
        "docs/archive/**"
      ]
    },
    "execution_contract": {
      "before_editing": [
        "identify module and owned paths",
        "choose real validation commands"
      ],
      "closeout": {
        "required_human_fields": [
          "changes",
          "validation",
          "unverified",
          "risks",
          "release_impact"
        ]
      }
    },
    "task_routes": {
      "development": [
        "docs/README.md"
      ],
      "review": [
        "docs/README.md"
      ],
      "delivery": [
        "MAWFLOW_CLI.md"
      ],
      "governance": [
        "PROJECT_COMMANDS.md"
      ]
    },
    "tool_adapters": {
      "codex": {
        "file": "AGENTS.md",
        "loader": "instructions",
        "status": "supported"
      },
      "claude": {
        "file": "CLAUDE.md",
        "loader": "import",
        "status": "supported"
      },
      "gemini": {
        "file": "GEMINI.md",
        "loader": "import",
        "status": "supported"
      },
      "cursor": {
        "file": "AGENTS.md",
        "loader": "instructions",
        "status": "supported"
      },
      "generic_ai": {
        "file": "AI_START_HERE.md",
        "loader": "manual",
        "status": "supported"
      },
      "chatgpt_web": {
        "file": "CHATGPT.md",
        "loader": "repository_links",
        "status": "supported"
      }
    },
    "tool_preferences": {
      "rtk": "optional_with_native_fallback",
      "mcp": "optional",
      "skills": "optional"
    },
    "git_policy": {
      "commit": "project_policy",
      "push": "project_policy",
      "mirror": "project_policy"
    }
  },
  "adapters": {
    "codex": {
      "file": "AGENTS.md",
      "loader": "instructions",
      "status": "supported"
    },
    "claude": {
      "file": "CLAUDE.md",
      "loader": "import",
      "status": "supported"
    },
    "gemini": {
      "file": "GEMINI.md",
      "loader": "import",
      "status": "supported"
    },
    "cursor": {
      "file": "AGENTS.md",
      "loader": "instructions",
      "status": "supported"
    },
    "generic_ai": {
      "file": "AI_START_HERE.md",
      "loader": "manual",
      "status": "supported"
    },
    "chatgpt_web": {
      "file": "CHATGPT.md",
      "loader": "repository_links",
      "status": "supported"
    }
  },
  "rules": [
    {
      "id": "preserve_project_facts",
      "severity": "required",
      "summary": "项目事实优先于模板默认值；不覆盖业务 README、源码、组件标识或既有规则。"
    },
    {
      "id": "scope_work",
      "severity": "required",
      "summary": "先定位模块、允许修改路径与禁止路径，只提交当前任务的改动。"
    },
    {
      "id": "protect_secrets",
      "severity": "required",
      "summary": "共享输出不得包含凭据值、私钥、客户隐私、本机绑定或未脱敏日志。"
    },
    {
      "id": "manual_prompts",
      "severity": "required",
      "summary": "prompts、归档和运行产物只在用户明确指定且任务需要时读取。"
    },
    {
      "id": "validate_evidence",
      "severity": "required",
      "summary": "执行项目真实验证；分别说明实现、测试、部署与真人验收证据。"
    },
    {
      "id": "respect_authorization",
      "severity": "required",
      "summary": "沿用当前任务已有授权；发布、外部写入与破坏性操作按项目策略和实际授权执行。"
    }
  ],
  "task_kinds": [
    "development",
    "review",
    "delivery",
    "governance"
  ],
  "capability_tiers": {
    "files": {
      "required": true,
      "benefits": [
        "project facts",
        "module navigation",
        "shared rules",
        "handoff"
      ]
    },
    "cli": {
      "required": false,
      "benefits": [
        "doctor",
        "bounded context",
        "preview and migration"
      ]
    },
    "mcp": {
      "required": false,
      "benefits": [
        "structured tool access under project authorization"
      ]
    }
  }
}
