{
  "schema": "mawflow.agent_contract.v1",
  "protocol_version": 1,
  "entry_defaults": {
    "schema_version": 3,
    "agent_protocol_version": 1,
    "startup": {
      "recommended_order": [
        "AI_START_HERE.md",
        ".maw/agent-entry.yaml",
        ".maw/agent-context.md",
        ".maw/project.yaml",
        ".maw/components.yaml",
        ".maw/modules.yaml"
      ],
      "read_policy": {
        "docs_are_on_demand": true,
        "prompts_are_manual_only": true,
        "archive_is_not_default_context": true
      }
    },
    "facts": {
      "project": ".maw/project.yaml",
      "subprojects": ".maw/subprojects.yaml",
      "code_sources": ".maw/code-sources.yaml",
      "deployment_targets": ".maw/deployments.yaml",
      "components": ".maw/components.yaml",
      "modules": ".maw/modules.yaml",
      "runtime": ".maw/app-runtime.yaml",
      "standards": ".maw/standards.yaml"
    },
    "protected_paths": {
      "never_commit": [
        ".local/**",
        ".maw/*.local.yaml",
        ".ssh/**",
        "artifacts/**"
      ],
      "manual_only": [
        "prompts/**",
        "docs/archive/**"
      ]
    },
    "execution_contract": {
      "before_editing": [
        "identify module and owned paths",
        "choose real validation commands"
      ],
      "closeout": {
        "required_human_fields": [
          "changes",
          "validation",
          "unverified",
          "risks",
          "release_impact"
        ],
        "stable_metadata": [
          "task_lifecycle_status",
          "resource_cleanup_status"
        ]
      },
      "document_source_capture": {
        "schema": "mawflow.document_source.v1",
        "policy": "docs/ai-coding/document-source-capture.md",
        "directory": "docs/intake",
        "tool": "ops/scripts/capture-document-source.py",
        "read_only": "deferred_read_only",
        "closeout_field": "document_source_capture",
        "preferred_schema": "mawflow.document_source.v2",
        "event_schema": "mawflow.document_work_event.v1",
        "event_template": "docs/intake/event-template.json",
        "record_action": "record-event",
        "closeout_check": "check-event",
        "automatic_triggers": [
          "clarification",
          "decision",
          "correction",
          "progress",
          "blocked",
          "verification",
          "handoff"
        ]
      },
      "update_notes": {
        "policy": "docs/ai-coding/update-notes.md",
        "source": ".maw/changes/*.yaml",
        "record_type": "update_note",
        "command": "python3 ops/scripts/generate-update-notes.py",
        "default_limit": 100,
        "trigger": "verified_user_visible_change",
        "append_only": true,
        "read_only": "deferred_read_only",
        "closeout_field": "update_notes_status"
      },
      "development_resources": {
        "policy": "docs/ai-coding/development-resources.md",
        "checker": "python3 ops/scripts/development-resources.py check",
        "default_heavy_job_limit": 1,
        "coordination_scope": "same_user_same_device",
        "checkpoints": [
          "task_start",
          "session_resume",
          "service_start",
          "before_heavy_job",
          "after_heavy_job",
          "milestone"
        ],
        "communication": "capability_negotiated_cli_or_authorized_local_mcp",
        "unavailable_cli": "project_files_fallback",
        "read_only_check_no_writes": true,
        "device_policy_schema": "mawflow.development_resource_policy.v1",
        "device_policy_location": "user_home/.local/config/maw-development-resources.json",
        "host_capability": "host.development_resources",
        "docker_runner": "python3 ops/scripts/development-resources.py run --workload docker --execute -- <authorized-command>"
      },
      "standards": {
        "policy": "docs/standards/README.md",
        "catalog": ".maw/standards.yaml",
        "checker": "python3 ops/scripts/manage-project-standards.py check",
        "context": "python3 ops/scripts/manage-project-standards.py context --phase <phase> --task-class <class> --task-kind <kind>",
        "read_policy": "catalog_then_selected_authority_only",
        "authorization_granted": false,
        "legacy_missing": "not_adopted_no_development_block",
        "execution_policy": "docs/standards/execution-protocol.md",
        "execution_protocol": 1,
        "plan": "python3 ops/scripts/manage-project-standards.py plan-task --input <task-snapshot>",
        "report": "python3 ops/scripts/manage-project-standards.py report-task --input <task-snapshot>"
      },
      "task_lifecycle": {
        "policy": "docs/ai-coding/task-lifecycle.md",
        "schema": "mawflow.task_lifecycle.v1",
        "snapshot_extension": "mawflow.standard_task_snapshot.v1.lifecycle",
        "checker": "python3 ops/scripts/manage-project-standards.py validate-task --input <task-snapshot>",
        "stages": [
          "scoped",
          "preparing",
          "executing",
          "verifying",
          "closing",
          "ended"
        ],
        "closeout_fields": [
          "task_lifecycle_status",
          "resource_cleanup_status"
        ],
        "existing_authorization_persists": true,
        "task_master_unchanged": true,
        "read_only_no_project_writes": true,
        "live_cleanup_enforcement": "executor_capability_required",
        "automatic_cleanup_without_receipt": "pending_automatic",
        "preferred_protocol_revision": 2
      }
    },
    "task_routes": {
      "development": [
        "docs/README.md"
      ],
      "review": [
        "docs/README.md"
      ],
      "delivery": [
        "MAWFLOW_CLI.md"
      ],
      "governance": [
        "PROJECT_COMMANDS.md"
      ],
      "standards": [
        "docs/standards/README.md",
        ".maw/standards.yaml"
      ]
    },
    "tool_adapters": {
      "codex": {
        "file": "AGENTS.md",
        "loader": "instructions",
        "status": "supported"
      },
      "claude": {
        "file": "CLAUDE.md",
        "loader": "import",
        "status": "supported"
      },
      "gemini": {
        "file": "GEMINI.md",
        "loader": "import",
        "status": "supported"
      },
      "cursor": {
        "file": "AGENTS.md",
        "loader": "instructions",
        "status": "supported"
      },
      "generic_ai": {
        "file": "AI_START_HERE.md",
        "loader": "manual",
        "status": "supported"
      },
      "chatgpt_web": {
        "file": "CHATGPT.md",
        "loader": "repository_links",
        "status": "supported"
      }
    },
    "tool_preferences": {
      "rtk": "optional_with_native_fallback",
      "mcp": "optional",
      "skills": "optional"
    },
    "git_policy": {
      "commit": "project_policy",
      "push": "project_policy",
      "mirror": "project_policy"
    }
  },
  "adapters": {
    "codex": {
      "file": "AGENTS.md",
      "loader": "instructions",
      "status": "supported"
    },
    "claude": {
      "file": "CLAUDE.md",
      "loader": "import",
      "status": "supported"
    },
    "gemini": {
      "file": "GEMINI.md",
      "loader": "import",
      "status": "supported"
    },
    "cursor": {
      "file": "AGENTS.md",
      "loader": "instructions",
      "status": "supported"
    },
    "generic_ai": {
      "file": "AI_START_HERE.md",
      "loader": "manual",
      "status": "supported"
    },
    "chatgpt_web": {
      "file": "CHATGPT.md",
      "loader": "repository_links",
      "status": "supported"
    }
  },
  "rules": [
    {
      "id": "preserve_project_facts",
      "severity": "required",
      "summary": "项目事实优先于模板默认值；不覆盖业务 README、源码、组件标识或既有规则。"
    },
    {
      "id": "scope_work",
      "severity": "required",
      "summary": "先定位模块、允许修改路径与禁止路径，只提交当前任务的改动。"
    },
    {
      "id": "protect_secrets",
      "severity": "required",
      "summary": "共享输出不得包含凭据值、私钥、客户隐私、本机绑定或未脱敏日志。"
    },
    {
      "id": "manual_prompts",
      "severity": "required",
      "summary": "prompts、归档和运行产物只在用户明确指定且任务需要时读取。"
    },
    {
      "id": "validate_evidence",
      "severity": "required",
      "summary": "执行项目真实验证；分别说明实现、测试、部署与真人验收证据。"
    },
    {
      "id": "respect_authorization",
      "severity": "required",
      "summary": "沿用当前任务已有授权；发布、外部写入与破坏性操作按项目策略和实际授权执行。"
    },
    {
      "id": "capture_document_sources",
      "severity": "required",
      "summary": "需求澄清、用户决定、纠偏、关键发现和验证收口时，按 docs/ai-coding/document-source-capture.md 收录最小来源及回执；只读任务只输出待收录摘要，AI 推断不得自动确认。"
    },
    {
      "id": "capture_business_and_work_events",
      "severity": "required",
      "summary": "获准修改的任务在澄清、决定、纠偏和阶段收口时自动执行来源事件收录与 check-event 回读；业务 key/scope 保持稳定，待确认不覆盖已确认，工作记录不替代任务主账。只读或禁记时不写入。"
    },
    {
      "id": "record_project_update_notes",
      "severity": "required",
      "summary": "获准修改且形成对使用者有意义的新增、优化、修复、安全或使用文档变化时，按 docs/ai-coding/update-notes.md 追加 update_note 权威片段并生成最近100条、完整历史与云端分页；只读不落盘，开发、发布、验证和真人验收独立标注。"
    },
    {
      "id": "coordinate_development_resources",
      "severity": "required",
      "summary": "本地对话开发开工、恢复及重任务前后按 docs/ai-coding/development-resources.md 检查资源和已装工作台/CLI；按需复用服务，同一用户跨项目重任务默认串行，离线回退项目文件，不自动安装、调参、停服务或上传会话。"
    },
    {
      "id": "stage_standards_scoped_execution",
      "severity": "required",
      "summary": "按docs/standards/README.md和规范目录选择六阶段及任务深度，只读命中权威；授权、模块边界、状态与证据独立。未采用/空测试/过期证据不称通过；规范快照不替代原任务、测试、发布或真人验收。"
    },
    {
      "id": "task_lifecycle_and_resource_closeout",
      "severity": "required",
      "summary": "按 docs/ai-coding/task-lifecycle.md 完成定界、准备、执行、验证、交付与资源收尾；失败、取消、等待、交接同样清点本任务资源，借用页面交还控制，临时标签按工具文档关闭，保留须有用途/归属/复查条件；待自动收尾、失败和未知不得称已释放，执行结束不等于业务验收关闭。"
    }
  ],
  "task_kinds": [
    "development",
    "review",
    "delivery",
    "governance"
  ],
  "capability_tiers": {
    "files": {
      "required": true,
      "benefits": [
        "project facts",
        "module navigation",
        "shared rules",
        "handoff"
      ]
    },
    "cli": {
      "required": false,
      "benefits": [
        "doctor",
        "bounded context",
        "preview and migration"
      ]
    },
    "mcp": {
      "required": false,
      "benefits": [
        "structured tool access under project authorization"
      ]
    }
  }
}
