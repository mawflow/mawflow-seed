{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "task_ref",
    "phase",
    "task_class",
    "task_kind",
    "states",
    "scope",
    "authorization",
    "verification",
    "evidence"
  ],
  "properties": {
    "schema": {
      "const": "mawflow.standard_task_snapshot.v1"
    },
    "task_ref": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        "initiation",
        "design",
        "development",
        "testing",
        "deployment",
        "delivery"
      ]
    },
    "task_class": {
      "enum": [
        "small_change",
        "iteration",
        "formal_delivery"
      ]
    },
    "task_kind": {
      "enum": [
        "read_only",
        "modify",
        "test",
        "deploy",
        "deliver"
      ]
    },
    "states": {
      "type": "object",
      "required": [
        "implementation",
        "verification",
        "external_integration",
        "delivery",
        "deployment",
        "human_acceptance"
      ],
      "properties": {
        "implementation": {
          "enum": [
            "pending",
            "partial",
            "passed",
            "failed",
            "not_applicable"
          ]
        },
        "verification": {
          "enum": [
            "pending",
            "partial",
            "passed",
            "failed",
            "not_applicable"
          ]
        },
        "external_integration": {
          "enum": [
            "pending",
            "partial",
            "passed",
            "failed",
            "not_applicable"
          ]
        },
        "delivery": {
          "enum": [
            "pending",
            "partial",
            "passed",
            "failed",
            "not_applicable"
          ]
        },
        "deployment": {
          "enum": [
            "pending",
            "partial",
            "passed",
            "failed",
            "not_applicable"
          ]
        },
        "human_acceptance": {
          "enum": [
            "pending",
            "partial",
            "passed",
            "failed",
            "not_applicable"
          ]
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "source_revision",
        "environment",
        "module_keys",
        "read_paths",
        "write_paths",
        "blocked_paths",
        "target_baseline"
      ],
      "properties": {
        "source_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "target_baseline": {
          "type": "string"
        },
        "module_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "read_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "write_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocked_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidate": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "commit",
                "working_tree",
                "artifact"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "commit"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "pattern": "^[0-9a-f]{40}$"
                  }
                }
              },
              "else": {
                "properties": {
                  "value": {
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "authorization": {
      "type": "object",
      "required": [
        "mode",
        "source_ref",
        "scope_ref",
        "environments",
        "allowed_actions"
      ],
      "properties": {
        "mode": {
          "enum": [
            "read_only",
            "modify"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "scope_ref": {
          "type": "string",
          "minLength": 1
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "suites"
      ],
      "properties": {
        "suites": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "status",
              "evidence_refs"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "pending",
                  "partial",
                  "passed",
                  "failed",
                  "not_applicable"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "axis",
          "status"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "content_hash": {
            "type": "string"
          },
          "source_revision": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "scope_hash": {
            "type": "string"
          },
          "record_ref": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "confirmation_ref": {
            "type": "string"
          },
          "axis": {
            "enum": [
              "implementation",
              "verification",
              "external_integration",
              "delivery",
              "deployment",
              "human_acceptance"
            ]
          },
          "status": {
            "enum": [
              "pending",
              "partial",
              "passed",
              "failed",
              "not_applicable"
            ]
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "task_ref": {
            "type": "string",
            "minLength": 1
          },
          "run_ref": {
            "type": "string",
            "minLength": 1
          },
          "scope_revision": {
            "type": "integer",
            "minimum": 1
          },
          "candidate": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "commit",
                  "working_tree",
                  "artifact"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "commit"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "value": {
                      "pattern": "^[0-9a-f]{40}$"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "value": {
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  }
                }
              }
            ]
          },
          "reuse": {
            "type": "object",
            "properties": {
              "from_run_ref": {
                "type": "string",
                "minLength": 1
              },
              "to_run_ref": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "record_ref": {
                "type": "string",
                "minLength": 1
              },
              "checked_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "from_run_ref",
              "to_run_ref",
              "reason",
              "record_ref",
              "checked_at"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    "lifecycle": {
      "$ref": "task-lifecycle.schema.json"
    },
    "evidence_policy": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "mawflow.task_evidence_policy.v1"
        },
        "run_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema",
        "run_ref"
      ],
      "additionalProperties": false
    },
    "standards_binding": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "mawflow.standards_binding.v1"
        },
        "catalog_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "selection": {
          "type": "object",
          "properties": {
            "phase": {
              "enum": [
                "initiation",
                "design",
                "development",
                "testing",
                "deployment",
                "delivery"
              ]
            },
            "task_class": {
              "enum": [
                "small_change",
                "iteration",
                "formal_delivery"
              ]
            },
            "task_kind": {
              "enum": [
                "read_only",
                "modify",
                "test",
                "deploy",
                "deliver"
              ]
            },
            "facts": {
              "type": "object",
              "properties": {
                "source_change": {
                  "type": "boolean"
                },
                "project_setup": {
                  "type": "boolean"
                },
                "requirements_change": {
                  "type": "boolean"
                },
                "public_contract": {
                  "type": "boolean"
                },
                "external_dependency": {
                  "type": "boolean"
                },
                "browser": {
                  "type": "boolean"
                },
                "database": {
                  "type": "boolean"
                },
                "resources": {
                  "type": "boolean"
                },
                "knowledge_reuse": {
                  "type": "boolean"
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "phase",
            "task_class",
            "task_kind",
            "facts"
          ],
          "additionalProperties": false
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "fingerprint": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "decision": {
                "enum": [
                  "applicable",
                  "not_applicable",
                  "exception",
                  "pending"
                ]
              },
              "reason": {
                "type": "string"
              },
              "record_ref": {
                "type": "string"
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "authorization_ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "key",
              "version",
              "fingerprint",
              "decision",
              "reason",
              "record_ref",
              "evidence_refs"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema",
        "catalog_hash",
        "selection",
        "rules"
      ],
      "additionalProperties": false
    },
    "related_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "evidence_policy"
        ]
      },
      "then": {
        "properties": {
          "scope": {
            "required": [
              "candidate"
            ]
          },
          "evidence": {
            "items": {
              "if": {
                "properties": {
                  "status": {
                    "const": "passed"
                  }
                }
              },
              "then": {
                "required": [
                  "method",
                  "observed_at",
                  "task_ref",
                  "run_ref",
                  "candidate"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
