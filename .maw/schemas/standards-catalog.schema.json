{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "catalog_version",
    "authority_policy",
    "phases",
    "rules"
  ],
  "properties": {
    "schema": {
      "const": "mawflow.standards_catalog.v1"
    },
    "catalog_version": {
      "type": "string"
    },
    "authority_policy": {
      "const": "catalog_references_only_no_parallel_rule_body"
    },
    "phases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "key",
          "title",
          "guide"
        ],
        "properties": {
          "key": {
            "enum": [
              "initiation",
              "design",
              "development",
              "testing",
              "deployment",
              "delivery"
            ]
          },
          "title": {
            "type": "string"
          },
          "guide": {
            "type": "string"
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "key",
          "title",
          "category",
          "primary_phase",
          "trigger",
          "authority",
          "owner",
          "requirement",
          "enforcement",
          "version",
          "exception_policy",
          "reuse_policy",
          "applies_to_phases",
          "task_classes",
          "task_kinds",
          "deliverables",
          "validation"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "common",
              "stage",
              "project",
              "resource"
            ]
          },
          "primary_phase": {
            "enum": [
              "initiation",
              "design",
              "development",
              "testing",
              "deployment",
              "delivery"
            ]
          },
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "requirement": {
            "enum": [
              "required",
              "conditional",
              "recommended"
            ]
          },
          "enforcement": {
            "enum": [
              "documented",
              "manual",
              "script"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "exception_policy": {
            "type": "string",
            "minLength": 1
          },
          "reuse_policy": {
            "type": "string",
            "minLength": 1
          },
          "applies_to_phases": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "initiation",
                "design",
                "development",
                "testing",
                "deployment",
                "delivery"
              ]
            }
          },
          "task_classes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "small_change",
                "iteration",
                "formal_delivery"
              ]
            }
          },
          "task_kinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "read_only",
                "modify",
                "test",
                "deploy",
                "deliver"
              ]
            }
          },
          "deliverables": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "validation": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "applicability": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "any_facts": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "source_change",
                    "project_setup",
                    "requirements_change",
                    "public_contract",
                    "external_dependency",
                    "browser",
                    "database",
                    "resources",
                    "knowledge_reuse"
                  ]
                }
              },
              "all_facts": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "source_change",
                    "project_setup",
                    "requirements_change",
                    "public_contract",
                    "external_dependency",
                    "browser",
                    "database",
                    "resources",
                    "knowledge_reuse"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
